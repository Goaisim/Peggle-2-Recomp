+uint32_t CollectLastImportsSignalSafe(RexImportTraceEntry* out, uint32_t max_entries) {
+  if (!out || max_entries == 0) return 0;
+  struct OrderedSlot {
+    uint64_t seq = 0;
+    RexImportTraceEntry entry{};
+  };
+  OrderedSlot items[kLastImportRingSize]{};
+  uint32_t n = 0;
+  for (uint32_t i = 0; i < kLastImportRingSize; ++i) {
+    const RexImportTraceSlot& slot = g_last_imports[i];
+    // Retry once without blocking if a writer updates this slot concurrently.
+    for (int attempt = 0; attempt < 2; ++attempt) {
+      const uint64_t s1 = slot.seq.load(std::memory_order_acquire);
+      if (s1 == 0) break;
+      const char* nm = slot.name.load(std::memory_order_relaxed);
+      const uint32_t a3 = slot.r3.load(std::memory_order_relaxed);
+      const uint32_t a4 = slot.r4.load(std::memory_order_relaxed);
+      const uint32_t rv = slot.return_value.load(std::memory_order_relaxed);
+      std::atomic_thread_fence(std::memory_order_acquire);
+      const uint64_t s2 = slot.seq.load(std::memory_order_relaxed);
+      if (s1 == s2 && nm && nm[0] != '\0') {
+        items[n++] = OrderedSlot{s1, RexImportTraceEntry{nm, a3, a4, rv}};
+        break;
+      }
+    }
+  }
+  for (uint32_t i = 1; i < n; ++i) {
+    const OrderedSlot key = items[i];
+    uint32_t j = i;
+    while (j > 0 && items[j - 1].seq > key.seq) {
+      items[j] = items[j - 1];
+      --j;
+    }
+    items[j] = key;
+  }
+  const uint32_t count = n < max_entries ? n : max_entries;
+  const uint32_t start = n - count;
+  for (uint32_t i = 0; i < count; ++i) {
+    out[i] = items[start + i].entry;
+  }
+  return count;
+}
