+void RecordVfsOpenFail(std::string_view failed_path) {
+  g_vfs_open_fail.fetch_add(1, std::memory_order_relaxed);
+  std::string clean(failed_path);
+  for (char& c : clean) {
+    if (c == '\\') c = '/';
+  }
+  auto slash = clean.find_last_of('/');
+  if (slash != std::string::npos && slash + 1 < clean.size()) {
+    clean = clean.substr(slash + 1);
+  }
+  if (!clean.empty()) {
+    std::lock_guard<std::mutex> lock(g_telemetry_str_mutex);
+    g_vfs_last_fail_name = std::move(clean);
+  }
+  if (!failed_path.empty()) {
+    AppendRecentFail("VFS", failed_path);
