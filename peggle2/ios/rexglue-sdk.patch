+static float PaceGuestFrame60Hz() {
+#if defined(_WIN32)
+  static std::once_flag s_time_period_once;
+  std::call_once(s_time_period_once, []() { timeBeginPeriod(1); });
+#endif
+
+  if (rex::IsAppBackgroundPaused()) {
+    rex::WaitWhileAppBackgroundPaused();
+    std::lock_guard<std::mutex> lock(s_guest_pacer_mutex);
+    s_pacer_initialized = false;
+  }
+
+  // Unconditionally clamp guest swaps to <= 60.0 Hz (16.666667 ms minimum) regardless of TargetFPS/VSync/Limiter.
+  double scalar = std::clamp(rex::chrono::Clock::guest_time_scalar(), 0.1, 1.0);
+  const auto guest_interval = std::chrono::nanoseconds(
+      std::max<int64_t>(16'666'667LL, static_cast<int64_t>(16'666'667.0 / scalar)));
+  const auto max_catchup_skew = std::chrono::milliseconds(2);
+
+  std::chrono::steady_clock::time_point deadline;
+  {
+    std::lock_guard<std::mutex> lock(s_guest_pacer_mutex);
+    const auto now = std::chrono::steady_clock::now();
+    if (!s_pacer_initialized || s_next_guest_deadline > now + guest_interval) {
+      s_next_guest_deadline = now + guest_interval;
+      s_pacer_initialized = true;
+    } else if (now > s_next_guest_deadline + max_catchup_skew) {
+      // Clamp stalled frames to steady monotonic 60.0 Hz without multi-frame bursts.
+      s_next_guest_deadline = now;
+    }
+    deadline = s_next_guest_deadline;
+    s_next_guest_deadline += guest_interval;
+  }
+
+  const auto sleep_start = std::chrono::steady_clock::now();
+#if defined(__APPLE__) || (!defined(_MSC_VER) && !defined(__x86_64__) && !defined(_M_X64))
+  // Use true OS blocking sleep on Apple/ARM64 (no tight yield spin-wait).
+  if (sleep_start < deadline) {
+    std::this_thread::sleep_until(deadline);
+  }
+  if (rex::IsAppBackgroundPaused()) {
+    rex::WaitWhileAppBackgroundPaused();
+    std::lock_guard<std::mutex> lock(s_guest_pacer_mutex);
+    s_pacer_initialized = false;
+  }
+  return std::chrono::duration<float, std::milli>(std::chrono::steady_clock::now() - sleep_start)
+      .count();
+#else
+  while (true) {
+    const auto now = std::chrono::steady_clock::now();
+    if (now >= deadline) {
+      return std::chrono::duration<float, std::milli>(now - sleep_start).count();
+    }
+    const auto remaining_ns =
+        std::chrono::duration_cast<std::chrono::nanoseconds>(deadline - now).count();
+    if (remaining_ns > 2200000LL) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    } else {
+      _mm_pause();
+    }
+  }
+#endif
