+void Presenter::UpdateVisualTurretSample(float angle_rad, uint32_t dot_count,
+                                         uint64_t timestamp_ms) {
+  std::lock_guard<std::mutex> lock(s_visual_turret_mutex);
+  s_visual_turret_sample.angle_rad = angle_rad;
+  s_visual_turret_sample.dot_count = dot_count;
+  s_visual_turret_sample.timestamp_ms = timestamp_ms;
+  s_visual_turret_sample.sequence = ++s_visual_turret_seq;
+}
+
+bool Presenter::GetLatestVisualTurretSample(VisualTurretSample& out_sample, uint64_t min_sequence) {
+  std::lock_guard<std::mutex> lock(s_visual_turret_mutex);
+  if (s_visual_turret_sample.dot_count == 0 || s_visual_turret_sample.sequence <= min_sequence) {
+    return false;
+  }
+  out_sample = s_visual_turret_sample;
+  return true;
+}
