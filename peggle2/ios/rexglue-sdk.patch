+bool D3D12CommandProcessor::InitializeTimestampQueryResources() {
+  ShutdownTimestampQueryResources();
+  const auto& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  ID3D12CommandQueue* queue = provider.GetDirectQueue();
+  if (!device || !queue) {
+    return false;
+  }
+  if (FAILED(queue->GetTimestampFrequency(&timestamp_frequency_)) || timestamp_frequency_ == 0) {
+    timestamp_frequency_ = 0;
+    return false;
+  }
+  D3D12_QUERY_HEAP_DESC heap_desc{};
+  heap_desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+  heap_desc.Count = kMaxTimestampFrames * 2;
+  if (FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&timestamp_query_heap_)))) {
+    timestamp_frequency_ = 0;
+    return false;
+  }
+  D3D12_RESOURCE_DESC buf_desc{};
+  ui::d3d12::util::FillBufferResourceDesc(buf_desc, sizeof(uint64_t) * kMaxTimestampFrames * 2,
+                                          D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+                                             provider.GetHeapFlagCreateNotZeroed(), &buf_desc,
+                                             D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                             IID_PPV_ARGS(&timestamp_readback_)))) {
+    timestamp_query_heap_.Reset();
+    timestamp_frequency_ = 0;
+    return false;
+  }
+  D3D12_RANGE read_range{0, sizeof(uint64_t) * kMaxTimestampFrames * 2};
+  void* mapping = nullptr;
+  if (FAILED(timestamp_readback_->Map(0, &read_range, &mapping))) {
+    timestamp_readback_.Reset();
+    timestamp_query_heap_.Reset();
+    timestamp_frequency_ = 0;
+    return false;
+  }
+  timestamp_readback_mapping_ = reinterpret_cast<uint64_t*>(mapping);
+  std::memset(pending_timestamps_, 0, sizeof(pending_timestamps_));
+  return true;
+}
+
+void D3D12CommandProcessor::ShutdownTimestampQueryResources() {
+  frame_timestamp_started_ = false;
+  active_timestamp_slot_ = 0;
+  std::memset(pending_timestamps_, 0, sizeof(pending_timestamps_));
+  if (timestamp_readback_ && timestamp_readback_mapping_) {
+    timestamp_readback_->Unmap(0, nullptr);
+  }
+  timestamp_readback_mapping_ = nullptr;
+  timestamp_readback_.Reset();
+  timestamp_query_heap_.Reset();
+  timestamp_frequency_ = 0;
+}
