+std::string CleanGuestRelativePath(std::string_view path) {
+  std::string s(path);
+  for (char& c : s) {
+    if (c == '\\') c = '/';
+  }
+  if (s.starts_with("/??/")) {
+    s.erase(0, 4);
+  }
+  std::string lower = ToLowerAscii(s);
+  static constexpr std::string_view kPrefixes[] = {
+      "/device/harddisk0/partition1/",
+      "/device/harddisk0/partition1",
+      "/device/harddisk0/partitionsave/",
+      "/device/harddisk0/partitionsave",
+      "/device/harddisk0/partitioncache/",
+      "/device/harddisk0/partitioncache",
+      "/device/harddisk0/partitionupdate/",
+      "/device/harddisk0/partitionupdate",
+      "game:/",
+      "game:",
+      "d:/",
+      "d:",
+      "save:/",
+      "save:",
+      "cache:/",
+      "cache:",
+      "update:/",
+      "update:",
+  };
+  for (auto pfx : kPrefixes) {
+    if (lower.starts_with(pfx)) {
+      lower.erase(0, pfx.size());
+      break;
+    }
+  }
+  std::string cleaned;
+  cleaned.reserve(lower.size());
+  for (char c : lower) {
+    if (c == '/' && (cleaned.empty() || cleaned.back() == '/')) {
+      continue;
+    }
+    cleaned.push_back(c);
+  }
+  while (cleaned.starts_with("./")) {
+    cleaned.erase(0, 2);
+  }
+  while (!cleaned.empty() && cleaned.back() == '/') {
+    cleaned.pop_back();
+  }
+  return cleaned;
+}
+
+void ClearCaseInsensitivePathMap() {
+  std::lock_guard<std::mutex> lock(g_ios_case_map_mutex);
+  g_ios_case_map.clear();
+}
+
+void RegisterCaseInsensitivePath(std::string_view relative_guest_path,
+                                 std::string_view full_host_path) {
+  std::string key = CleanGuestRelativePath(relative_guest_path);
+  if (key.empty() || full_host_path.empty()) return;
+  std::lock_guard<std::mutex> lock(g_ios_case_map_mutex);
+  g_ios_case_map[key] = std::string(full_host_path);
+}
+
+std::string LookupCaseInsensitivePath(std::string_view guest_or_rel_path) {
+  std::string key = CleanGuestRelativePath(guest_or_rel_path);
+  if (key.empty()) return {};
+  std::lock_guard<std::mutex> lock(g_ios_case_map_mutex);
+  auto it = g_ios_case_map.find(key);
+  if (it != g_ios_case_map.end()) {
+    return it->second;
+  }
+  if (!key.starts_with("assets/")) {
+    auto it2 = g_ios_case_map.find("assets/" + key);
+    if (it2 != g_ios_case_map.end()) {
+      return it2->second;
+    }
+  }
+  return {};
+}
+
+static std::atomic<bool> g_app_bg_paused{false};
+static std::atomic<uint64_t> g_app_bg_pause_count{0};
+static std::mutex g_app_bg_mutex;
+static std::condition_variable g_app_bg_cv;
+
+void SetAppBackgroundPaused(bool paused) {
+#if REX_PLATFORM_IOS
+  {
+    std::lock_guard<std::mutex> lock(g_app_bg_mutex);
+    const bool prev = g_app_bg_paused.exchange(paused, std::memory_order_release);
+    if (paused && !prev) {
+      g_app_bg_pause_count.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+  g_app_bg_cv.notify_all();
+#else
+  (void)paused;
+  if (g_app_bg_paused.load(std::memory_order_acquire)) {
+    std::lock_guard<std::mutex> lock(g_app_bg_mutex);
+    g_app_bg_paused.store(false, std::memory_order_release);
+    g_app_bg_cv.notify_all();
+  }
+#endif
+}
+
+bool IsAppBackgroundPaused() {
+  return g_app_bg_paused.load(std::memory_order_acquire);
+}
+
+void WaitWhileAppBackgroundPaused() {
+  if (!g_app_bg_paused.load(std::memory_order_acquire)) return;
+  std::unique_lock<std::mutex> lock(g_app_bg_mutex);
+  g_app_bg_cv.wait(lock, []() { return !g_app_bg_paused.load(std::memory_order_acquire); });
+}
+
+uint64_t GetAppBackgroundPauseCount() {
+  return g_app_bg_pause_count.load(std::memory_order_relaxed);
+}
+
 }  // namespace rex
