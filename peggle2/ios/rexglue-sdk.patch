+REX_ALWAYS_INLINE uint16_t load_be_u16(const volatile void* ptr) noexcept {
+#if (defined(__x86_64__) || defined(_M_X64)) && (defined(__MOVBE__) || (defined(_MSC_VER) && defined(__AVX2__)))
+  return static_cast<uint16_t>(_loadbe_i16(const_cast<const void*>(ptr)));
+#else
+  return __builtin_bswap16(*reinterpret_cast<const volatile uint16_t*>(ptr));
+#endif
+}
+
+REX_ALWAYS_INLINE uint32_t load_be_u32(const volatile void* ptr) noexcept {
+#if (defined(__x86_64__) || defined(_M_X64)) && (defined(__MOVBE__) || (defined(_MSC_VER) && defined(__AVX2__)))
+  return static_cast<uint32_t>(_loadbe_i32(const_cast<const void*>(ptr)));
+#else
+  return __builtin_bswap32(*reinterpret_cast<const volatile uint32_t*>(ptr));
+#endif
+}
+
+REX_ALWAYS_INLINE uint64_t load_be_u64(const volatile void* ptr) noexcept {
+#if (defined(__x86_64__) || defined(_M_X64)) && (defined(__MOVBE__) || (defined(_MSC_VER) && defined(__AVX2__)))
+  return static_cast<uint64_t>(_loadbe_i64(const_cast<const void*>(ptr)));
+#else
+  return __builtin_bswap64(*reinterpret_cast<const volatile uint64_t*>(ptr));
+#endif
+}
+
+REX_ALWAYS_INLINE void store_be_u16(volatile void* ptr, uint16_t val) noexcept {
+#if (defined(__x86_64__) || defined(_M_X64)) && (defined(__MOVBE__) || (defined(_MSC_VER) && defined(__AVX2__)))
+  _storebe_i16(const_cast<void*>(ptr), static_cast<int16_t>(val));
+#else
+  *reinterpret_cast<volatile uint16_t*>(ptr) = __builtin_bswap16(val);
+#endif
+}
+
+REX_ALWAYS_INLINE void store_be_u32(volatile void* ptr, uint32_t val) noexcept {
+#if (defined(__x86_64__) || defined(_M_X64)) && (defined(__MOVBE__) || (defined(_MSC_VER) && defined(__AVX2__)))
+  _storebe_i32(const_cast<void*>(ptr), static_cast<int32_t>(val));
+#else
+  *reinterpret_cast<volatile uint32_t*>(ptr) = __builtin_bswap32(val);
