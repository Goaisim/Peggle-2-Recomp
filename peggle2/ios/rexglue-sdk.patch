+class ScopedKernelWaitTimer {
+ public:
+  explicit ScopedKernelWaitTimer(uint32_t wait_state = 2)
+      : start_(std::chrono::steady_clock::now()) {
+    if (XThread::IsInThread()) {
+      if (XThread* t = XThread::GetCurrentThread(); t && t->main_thread()) {
+        tracks_guest_state_ = true;
+        if (auto* ts = t->thread_state(); ts && ts->context()) {
+          rex::SetGuestLastLR(static_cast<uint32_t>(ts->context()->lr));
+        }
+        rex::SetGuestThreadState(wait_state);
+      }
+    }
+  }
+  ~ScopedKernelWaitTimer() {
+    if (tracks_guest_state_) {
+      rex::SetGuestThreadState(1);
+    }
+    const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now() - start_)
+                        .count();
+    if (ns > 0) {
+      rex::ui::Presenter::AddCurrentThreadKernelWaitNs(static_cast<uint64_t>(ns));
+    }
+  }
+
+ private:
+  std::chrono::steady_clock::time_point start_;
+  bool tracks_guest_state_ = false;
+};
