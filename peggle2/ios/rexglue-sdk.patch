+REX_GPU_EXPORT uint32_t RexGpu_GetUiMonitorSnapshot(RexGpuUiMonitorSnapshot* out_snapshot) {
+  g_ui_sniffer_lease_until_ms.store(NowSteadyMs() + 5000, std::memory_order_relaxed);
+  g_ui_sniffer_active.store(true, std::memory_order_release);
+  if (!out_snapshot) return 0;
+  std::lock_guard<std::mutex> lock(g_snapshot_mutex);
+  *out_snapshot = g_published_snapshot;
+  return g_published_snapshot.quad_count;
+}
