+struct RecentFailSnapshot {
+  uint32_t count = 0;
+  char entries[RexBootTelemetrySnapshot::kMaxRecentFails][160]{};
+};
+// Double-buffered so crash signal handlers read the last completed 5-entry snapshot lock-free.
+RecentFailSnapshot g_recent_fail_buf[2];
+std::atomic<uint32_t> g_recent_fail_active{0};
+
+void AppendRecentFail(std::string_view tag, std::string_view detail) {
+  std::string line;
+  line.reserve(tag.size() + 2 + detail.size());
+  line.append(tag);
+  line.append(": ");
+  line.append(detail);
+  for (char& c : line) {
+    if (c == '\\') c = '/';
+    if (c == '\r' || c == '\n') c = ' ';
+  }
+  constexpr size_t kMaxLen = sizeof(RecentFailSnapshot::entries[0]) - 1;
+  if (line.size() > kMaxLen) {
+    line = "..." + line.substr(line.size() - (kMaxLen - 3));
+  }
+  std::lock_guard<std::mutex> lock(g_telemetry_str_mutex);
+  const uint32_t cur = g_recent_fail_active.load(std::memory_order_relaxed);
+  const uint32_t next = 1u - cur;
+  RecentFailSnapshot& dst = g_recent_fail_buf[next];
+  dst = g_recent_fail_buf[cur];
+  if (dst.count < RexBootTelemetrySnapshot::kMaxRecentFails) {
+    CopyBoundedCString(dst.entries[dst.count], sizeof(dst.entries[0]), line.c_str());
+    ++dst.count;
+  } else {
+    // Keep KRNL/NET failures visible when noisy VFS probes miss.
+    uint32_t drop = 0;
+    if (tag == "VFS") {
+      for (uint32_t i = 0; i < RexBootTelemetrySnapshot::kMaxRecentFails; ++i) {
+        if (std::strncmp(dst.entries[i], "KRNL: ", 6) != 0 &&
+            std::strncmp(dst.entries[i], "NET: ", 5) != 0) {
+          drop = i;
+          break;
+        }
+      }
+    }
+    for (uint32_t i = drop + 1; i < RexBootTelemetrySnapshot::kMaxRecentFails; ++i) {
+      std::memcpy(dst.entries[i - 1], dst.entries[i], sizeof(dst.entries[0]));
+    }
+    CopyBoundedCString(dst.entries[RexBootTelemetrySnapshot::kMaxRecentFails - 1],
+                       sizeof(dst.entries[0]), line.c_str());
+  }
+  g_recent_fail_active.store(next, std::memory_order_release);
+}
