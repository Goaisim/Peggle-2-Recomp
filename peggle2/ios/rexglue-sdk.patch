+UiQuadSniffer::UiQuadSniffer(const RegisterFile& regs, const memory::Memory& memory)
+    : regs_(regs), memory_(&memory), interpreter_(regs, memory) {}
+
+void UiQuadSniffer::OnDraw(const Shader* vertex_shader, const Shader* pixel_shader,
+                           const PrimitiveProcessor::ProcessingResult& prim_result,
+                           reg::RB_DEPTHCONTROL normalized_depth_control, bool has_index_buffer,
+                           uint32_t index_base, xenos::IndexFormat index_format,
+                           xenos::Endian index_endian, uint32_t used_texture_mask) {
+  auto rb_modecontrol = regs_.Get<reg::RB_MODECONTROL>();
+  if (rb_modecontrol.edram_mode != xenos::EdramMode::kColorDepth) {
+    return;
+  }
+  ++dbg_draws_;
+  // 2D UI draws have Z test or Z write disabled.
+  if (normalized_depth_control.z_enable && normalized_depth_control.z_write_enable) {
+    ++dbg_rej_z_;
+    return;
+  }
+
+  xenos::PrimitiveType prim_type = prim_result.guest_primitive_type;
+  switch (prim_type) {
+    case xenos::PrimitiveType::kTriangleList:
+    case xenos::PrimitiveType::kTriangleStrip:
+    case xenos::PrimitiveType::kTriangleFan:
+    case xenos::PrimitiveType::kQuadList:
+    case xenos::PrimitiveType::kQuadStrip:
+    case xenos::PrimitiveType::kRectangleList:
+    case xenos::PrimitiveType::kPolygon:
+      break;
+    default:
+      return;
+  }
+
+  uint32_t vertex_count = prim_result.guest_draw_vertex_count;
+  if (vertex_count < 3 || vertex_count > 1024) {
+    ++dbg_rej_vcnt_;
+    return;
+  }
+  if (!vertex_shader || !ShaderInterpreter::CanInterpretShader(*vertex_shader)) {
+    ++dbg_rej_interp_;
+    return;
+  }
+
+  auto win_tl = regs_.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  auto win_br = regs_.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  int32_t win_x0 = int32_t(win_tl.tl_x);
+  int32_t win_y0 = int32_t(win_tl.tl_y);
+  int32_t win_w = int32_t(win_br.br_x) - win_x0;
+  int32_t win_h = int32_t(win_br.br_y) - win_y0;
+  if (win_w < 640 || win_h < 400) {
+    ++dbg_rej_win_;
+    return;
+  }
+
+  draw_util::Scissor scissor{};
+  draw_util::GetScissor(regs_, scissor, true);
+  if (!scissor.extent[0] || !scissor.extent[1]) {
+    return;
+  }
+
+  auto pa_cl_vte_cntl = regs_.Get<reg::PA_CL_VTE_CNTL>();
+  float xscale =
+      pa_cl_vte_cntl.vport_x_scale_ena ? regs_.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0f;
+  float xoffset =
+      pa_cl_vte_cntl.vport_x_offset_ena ? regs_.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0f;
+  float yscale =
+      pa_cl_vte_cntl.vport_y_scale_ena ? regs_.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0f;
+  float yoffset =
+      pa_cl_vte_cntl.vport_y_offset_ena ? regs_.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0f;
+  bool pretransformed_xy = pa_cl_vte_cntl.vtx_xy_fmt;
+
+  uint32_t index_offset = regs_[XE_GPU_REG_VGT_INDX_OFFSET];
+  uint32_t min_vtx_index = regs_[XE_GPU_REG_VGT_MIN_VTX_INDX];
+  uint32_t max_vtx_index = regs_[XE_GPU_REG_VGT_MAX_VTX_INDX];
+  bool reset_enabled = regs_.Get<reg::PA_SU_SC_MODE_CNTL>().multi_prim_ib_ena && has_index_buffer;
+  uint32_t reset_index = regs_[XE_GPU_REG_VGT_MULTI_PRIM_IB_RESET_INDX];
+
+  const uint16_t* ib16 = nullptr;
+  const uint32_t* ib32 = nullptr;
+  if (has_index_buffer) {
+    if (!memory_ || !index_base) {
+      return;
+    }
+    if (index_format == xenos::IndexFormat::kInt16) {
+      ib16 = memory_->TranslatePhysical<const uint16_t*>(index_base);
+    } else {
+      ib32 = memory_->TranslatePhysical<const uint32_t*>(index_base);
+    }
+    if (!ib16 && !ib32) {
+      return;
+    }
+  }
+
+  interpreter_.SetShader(*vertex_shader);
+  PositionExportSink sink;
+  interpreter_.SetExportSink(&sink);
+
+  struct ScreenPt {
+    float x, y;
+    bool valid;
+    bool reset;
+  };
+  ScreenPt pts[1024];
+  for (uint32_t i = 0; i < vertex_count; ++i) {
+    uint32_t idx = i;
+    if (has_index_buffer) {
+      idx = ib16 ? uint32_t(xenos::GpuSwap(ib16[i], index_endian))
+                 : (xenos::GpuSwap(ib32[i], index_endian) & xenos::kVertexIndexMask);
+      if (reset_enabled && idx == reset_index) {
+        pts[i] = {0.0f, 0.0f, false, true};
+        continue;
+      }
+      idx = std::clamp(idx + index_offset, min_vtx_index, max_vtx_index) & xenos::kVertexIndexMask;
+    } else {
+      idx = (idx + index_offset) & xenos::kVertexIndexMask;
+    }
+
+    sink.Reset();
+    interpreter_.temp_registers()[0] = float(idx);
+    interpreter_.Execute();
+    if (!sink.has_pos || !std::isfinite(sink.pos[0]) || !std::isfinite(sink.pos[1]) ||
+        !std::isfinite(sink.pos[3])) {
+      ++dbg_rej_vtx_;
+      pts[i] = {0.0f, 0.0f, false, false};
+      continue;
+    }
+    float x = sink.pos[0];
+    float y = sink.pos[1];
+    if (!pretransformed_xy) {
+      if (std::fabs(sink.pos[3]) < 1e-6f) {
+        pts[i] = {0.0f, 0.0f, false, false};
+        continue;
+      }
+      x /= sink.pos[3];
+      y /= sink.pos[3];
+    }
+    float px = x * xscale + xoffset;
+    float py = y * yscale + yoffset;
+    pts[i] = {px, py, true, false};
+  }
+
+  float sc_x0 = float(scissor.offset[0]);
+  float sc_y0 = float(scissor.offset[1]);
+  float sc_x1 = sc_x0 + float(scissor.extent[0]);
+  float sc_y1 = sc_y0 + float(scissor.extent[1]);
+
+  uint64_t vs_hash = vertex_shader->ucode_data_hash();
+  uint64_t ps_hash = pixel_shader ? pixel_shader->ucode_data_hash() : 0;
+  uint32_t color_hash = HashPixelConstants(regs_);
+
+  auto emit_aabb = [&](float min_x, float min_y, float max_x, float max_y) {
+    min_x = std::max(min_x, sc_x0);
+    min_y = std::max(min_y, sc_y0);
+    max_x = std::min(max_x, sc_x1);
+    max_y = std::min(max_y, sc_y1);
+    if (max_x <= min_x || max_y <= min_y) return;
+
+    float nx0 = std::clamp((min_x - float(win_x0)) / float(win_w), 0.0f, 1.0f);
+    float ny0 = std::clamp((min_y - float(win_y0)) / float(win_h), 0.0f, 1.0f);
+    float nx1 = std::clamp((max_x - float(win_x0)) / float(win_w), 0.0f, 1.0f);
+    float ny1 = std::clamp((max_y - float(win_y0)) / float(win_h), 0.0f, 1.0f);
+    float w = nx1 - nx0;
+    float h = ny1 - ny0;
+    if (w > 0.90f || h > 0.90f || w < 0.025f || h < 0.025f) {
+      ++dbg_rej_size_;
+      return;
+    }
+
+    if (current_frame_quads_.size() < 2048) {
+      current_frame_quads_.push_back(
+          {nx0, ny0, nx1, ny1, vs_hash, ps_hash, used_texture_mask, color_hash, 1});
+    }
+  };
+
+  auto emit_slice = [&](uint32_t start, uint32_t count) {
+    float min_x = 1e9f, min_y = 1e9f, max_x = -1e9f, max_y = -1e9f;
+    uint32_t valid = 0;
+    for (uint32_t k = 0; k < count; ++k) {
+      const ScreenPt& p = pts[start + k];
+      if (!p.valid) continue;
+      min_x = std::min(min_x, p.x);
+      min_y = std::min(min_y, p.y);
+      max_x = std::max(max_x, p.x);
+      max_y = std::max(max_y, p.y);
+      ++valid;
+    }
+    if (valid >= 3) {
+      emit_aabb(min_x, min_y, max_x, max_y);
+    }
+  };
+
+  if (prim_type == xenos::PrimitiveType::kQuadList) {
+    for (uint32_t i = 0; i + 3 < vertex_count; i += 4) {
+      if (pts[i].reset || pts[i + 1].reset || pts[i + 2].reset || pts[i + 3].reset) continue;
+      emit_slice(i, 4);
+    }
+  } else if (prim_type == xenos::PrimitiveType::kRectangleList) {
+    for (uint32_t i = 0; i + 2 < vertex_count; i += 3) {
+      if (!pts[i].valid || !pts[i + 1].valid || !pts[i + 2].valid) continue;
+      float p3x = pts[i + 1].x + pts[i + 2].x - pts[i].x;
+      float p3y = pts[i + 1].y + pts[i + 2].y - pts[i].y;
+      float min_x = std::min({pts[i].x, pts[i + 1].x, pts[i + 2].x, p3x});
+      float min_y = std::min({pts[i].y, pts[i + 1].y, pts[i + 2].y, p3y});
+      float max_x = std::max({pts[i].x, pts[i + 1].x, pts[i + 2].x, p3x});
+      float max_y = std::max({pts[i].y, pts[i + 1].y, pts[i + 2].y, p3y});
+      emit_aabb(min_x, min_y, max_x, max_y);
+    }
+  } else if (prim_type == xenos::PrimitiveType::kTriangleList) {
+    // Emit triangle AABBs; two triangles forming one quad immediately cluster together on swap.
+    for (uint32_t i = 0; i + 2 < vertex_count; i += 3) {
+      if (pts[i].reset || pts[i + 1].reset || pts[i + 2].reset) continue;
+      emit_slice(i, 3);
+    }
+  } else {
+    // Strip / fan / polygon: split on reset index, else emit per sub-strip.
+    uint32_t seg_start = 0;
+    for (uint32_t i = 0; i <= vertex_count; ++i) {
+      if (i == vertex_count || pts[i].reset) {
+        if (i - seg_start >= 3) {
+          emit_slice(seg_start, i - seg_start);
+        }
+        seg_start = i + 1;
+      }
+    }
+  }
+}
+
+void UiQuadSniffer::OnFrameSwap() {
+  ++frame_index_;
+  uint64_t seq = g_dpad_seq.load(std::memory_order_acquire);
+  if (seq != last_dpad_seen_seq_) {
+    last_dpad_seen_seq_ = seq;
+    post_dpad_frames_remaining_ = 8;
+  } else if (post_dpad_frames_remaining_ > 0) {
+    --post_dpad_frames_remaining_;
+  }
+
+  std::vector<RexGpuUiQuad> clusters;
+  clusters.reserve(current_frame_quads_.size());
+
+  // Cluster overlapping / multi-pass sub-quads into clean button containers.
+  for (const auto& q : current_frame_quads_) {
+    bool merged = false;
+    for (auto& c : clusters) {
+      float containment = 0.0f;
+      float iou = RectIoU(c.x0, c.y0, c.x1, c.y1, q.x0, q.y0, q.x1, q.y1, &containment);
+      float cw = std::max(c.x1, q.x1) - std::min(c.x0, q.x0);
+      float ch = std::max(c.y1, q.y1) - std::min(c.y0, q.y0);
+      if (cw <= 0.65f && ch <= 0.55f && (iou >= 0.30f || containment >= 0.72f)) {
+        c.x0 = std::min(c.x0, q.x0);
+        c.y0 = std::min(c.y0, q.y0);
+        c.x1 = std::max(c.x1, q.x1);
+        c.y1 = std::max(c.y1, q.y1);
+        c.color_hash ^= q.color_hash * 2654435761u;
+        c.texture_mask |= q.texture_mask;
+        c.prim_count += q.prim_count;
+        merged = true;
+        break;
+      }
+    }
+    if (!merged && clusters.size() < 128) {
+      RexGpuUiQuad item{};
+      item.x0 = q.x0;
+      item.y0 = q.y0;
+      item.x1 = q.x1;
+      item.y1 = q.y1;
+      item.vs_hash = q.vs_hash;
+      item.ps_hash = q.ps_hash;
+      item.texture_mask = q.texture_mask;
+      item.color_hash = q.color_hash;
+      item.prim_count = q.prim_count;
+      clusters.push_back(item);
+    }
+  }
+
+  // Detect active highlight rect from animation pulse, tint diff, or post-DPAD quad change.
+  int best_idx = -1;
+  float best_score = 0.0f;
+  for (size_t i = 0; i < clusters.size(); ++i) {
+    auto& c = clusters[i];
+    float cw = c.x1 - c.x0;
+    float ch = c.y1 - c.y0;
+    float ccx = 0.5f * (c.x0 + c.x1);
+    float ccy = 0.5f * (c.y0 + c.y1);
+
+    int match_idx = -1;
+    float best_match_iou = 0.0f;
+    for (size_t j = 0; j < prev_frame_clusters_.size(); ++j) {
+      const auto& p = prev_frame_clusters_[j];
+      float iou = RectIoU(c.x0, c.y0, c.x1, c.y1, p.x0, p.y0, p.x1, p.y1);
+      if (iou > best_match_iou && iou >= 0.45f) {
+        best_match_iou = iou;
+        match_idx = int(j);
+      }
+    }
+
+    float score = 0.0f;
+    if (match_idx >= 0) {
+      const auto& p = prev_frame_clusters_[match_idx];
+      float pw = p.x1 - p.x0;
+      float ph = p.y1 - p.y0;
+      float pcx = 0.5f * (p.x0 + p.x1);
+      float pcy = 0.5f * (p.y0 + p.y1);
+      float size_delta = std::fabs(cw - pw) + std::fabs(ch - ph);
+      float center_delta = std::hypotf(ccx - pcx, ccy - pcy);
+      if (size_delta > 0.0010f && size_delta < 0.08f && center_delta < 0.015f) {
+        c.flags |= 0x01;
+        score += 50.0f + size_delta * 1000.0f;
+      }
+      if (c.color_hash != p.color_hash || c.ps_hash != p.ps_hash ||
+          c.texture_mask != p.texture_mask) {
+        c.flags |= 0x04;
+        score += (post_dpad_frames_remaining_ > 0) ? 85.0f : 35.0f;
+      }
+    } else if (post_dpad_frames_remaining_ > 0 && !prev_frame_clusters_.empty()) {
+      c.flags |= 0x02;
+      score += 80.0f;
+    }
+    c.score = score;
+    if (score > best_score) {
+      best_score = score;
+      best_idx = int(i);
+    }
+  }
+
+  bool has_highlight = false;
+  RexGpuUiQuad active_highlight{};
+  if (best_idx >= 0 && best_score >= 30.0f) {
+    active_highlight = clusters[best_idx];
+    last_highlight_rect_ = active_highlight;
+    highlight_hold_frames_ = 25;
+    has_highlight = true;
+  } else if (highlight_hold_frames_ > 0) {
+    --highlight_hold_frames_;
+    float hcx = 0.5f * (last_highlight_rect_.x0 + last_highlight_rect_.x1);
+    float hcy = 0.5f * (last_highlight_rect_.y0 + last_highlight_rect_.y1);
+    float best_d = 0.05f;
+    int hold_idx = -1;
+    for (size_t i = 0; i < clusters.size(); ++i) {
+      const auto& c = clusters[i];
+      float iou = RectIoU(c.x0, c.y0, c.x1, c.y1, last_highlight_rect_.x0, last_highlight_rect_.y0,
+                          last_highlight_rect_.x1, last_highlight_rect_.y1);
+      float d = std::hypotf(0.5f * (c.x0 + c.x1) - hcx, 0.5f * (c.y0 + c.y1) - hcy);
+      if (iou >= 0.40f && d < best_d) {
+        best_d = d;
+        hold_idx = int(i);
+      }
+    }
+    if (hold_idx >= 0) {
+      last_highlight_rect_ = clusters[hold_idx];
+      active_highlight = last_highlight_rect_;
+      has_highlight = true;
+    }
+  }
+
+  RexGpuUiMonitorSnapshot snap{};
+  snap.frame_index = frame_index_;
+  snap.raw_quad_count = uint32_t(current_frame_quads_.size());
+  snap.quad_count = std::min<uint32_t>(128, uint32_t(clusters.size()));
+  snap.has_highlight = has_highlight ? 1 : 0;
+  snap.highlight_rect = active_highlight;
+  if (snap.quad_count > 0) {
+    std::memcpy(snap.quads, clusters.data(), snap.quad_count * sizeof(RexGpuUiQuad));
+  }
+  uint32_t layout_hash = 2166136261u;
+  for (uint32_t i = 0; i < snap.quad_count; ++i) {
+    layout_hash = (layout_hash ^ uint32_t(snap.quads[i].vs_hash)) * 16777619u;
+    layout_hash = (layout_hash ^ uint32_t(snap.quads[i].x0 * 100.0f)) * 16777619u;
+    layout_hash = (layout_hash ^ uint32_t(snap.quads[i].y0 * 100.0f)) * 16777619u;
+  }
+  if (has_highlight) {
+    std::snprintf(snap.screen_signature, sizeof(snap.screen_signature),
+                  "Q=%u RAW=%u SIG=%08X HL=(%.2f,%.2f)", snap.quad_count, snap.raw_quad_count,
+                  layout_hash, 0.5f * (active_highlight.x0 + active_highlight.x1),
+                  0.5f * (active_highlight.y0 + active_highlight.y1));
+  } else {
+    std::snprintf(snap.screen_signature, sizeof(snap.screen_signature),
+                  "Q=%u RAW=%u SIG=%08X HL=none D=%u Z=%u VC=%u I=%u W=%u V=%u S=%u",
+                  snap.quad_count, snap.raw_quad_count, layout_hash, dbg_draws_, dbg_rej_z_,
+                  dbg_rej_vcnt_, dbg_rej_interp_, dbg_rej_win_, dbg_rej_vtx_, dbg_rej_size_);
+  }
+  dbg_draws_ = dbg_rej_z_ = dbg_rej_vcnt_ = dbg_rej_interp_ = dbg_rej_win_ = dbg_rej_vtx_ =
+      dbg_rej_size_ = 0;
+
+  {
+    std::lock_guard<std::mutex> lock(g_snapshot_mutex);
+    g_published_snapshot = snap;
+  }
+
+  prev_frame_clusters_ = std::move(clusters);
+  current_frame_quads_.clear();
+  if (NowSteadyMs() > g_ui_sniffer_lease_until_ms.load(std::memory_order_relaxed)) {
+    g_ui_sniffer_active.store(false, std::memory_order_release);
+  }
+}
+
+}  // namespace rex::graphics
