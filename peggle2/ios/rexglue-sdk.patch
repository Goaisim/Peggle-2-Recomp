+void RecordLastImport(const char* name, uint32_t r3, uint32_t r4, uint32_t return_value) {
+  if (!name || name[0] == '\0') return;
+  const uint64_t ticket = g_last_import_seq.fetch_add(1, std::memory_order_relaxed);
+  RexImportTraceSlot& slot = g_last_imports[ticket & (kLastImportRingSize - 1u)];
+  slot.name.store(name, std::memory_order_relaxed);
+  slot.r3.store(r3, std::memory_order_relaxed);
+  slot.r4.store(r4, std::memory_order_relaxed);
+  slot.return_value.store(return_value, std::memory_order_relaxed);
+  slot.seq.store(ticket + 1u, std::memory_order_release);
+}
