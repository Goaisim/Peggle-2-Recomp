+void Presenter::UpdateScreenWatcherFrame(const uint8_t* pixels_rgbl, uint32_t width,
+                                         uint32_t height, uint64_t timestamp_ms) {
+  if (!pixels_rgbl || !width || !height) {
+    return;
+  }
+  const size_t byte_count = size_t(width) * size_t(height) * 4;
+  std::lock_guard<std::mutex> lock(s_screen_watcher_mutex);
+  s_screen_watcher_frame.width = width;
+  s_screen_watcher_frame.height = height;
+  s_screen_watcher_frame.timestamp_ms = timestamp_ms;
+  s_screen_watcher_frame.sequence = ++s_screen_watcher_seq;
+  s_screen_watcher_frame.pixels.assign(pixels_rgbl, pixels_rgbl + byte_count);
+}
+
+bool Presenter::GetLatestScreenWatcherFrame(ScreenWatcherFrame& out_frame, uint64_t min_sequence) {
+  std::lock_guard<std::mutex> lock(s_screen_watcher_mutex);
+  if (s_screen_watcher_frame.pixels.empty() || s_screen_watcher_frame.sequence <= min_sequence) {
+    return false;
+  }
+  out_frame = s_screen_watcher_frame;
+  return true;
+}
