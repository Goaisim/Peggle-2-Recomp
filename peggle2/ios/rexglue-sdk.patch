+      arg[0] = static_cast<uint8_t>((u >> 24) & 0xFFu);
+      arg[1] = static_cast<uint8_t>((u >> 16) & 0xFFu);
+      arg[2] = static_cast<uint8_t>((u >> 8) & 0xFFu);
+      arg[3] = static_cast<uint8_t>((u >> 0) & 0xFFu);
