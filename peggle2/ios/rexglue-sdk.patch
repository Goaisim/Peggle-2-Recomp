+void GraphicsUploadBufferPool::TrimUnusedPages(size_t keep_count) {
+  if (current_page_used_ != 0 && writable_first_ != nullptr) {
+    keep_count = std::max(keep_count, size_t(1));
+  }
+  size_t count = 0;
+  Page* prev = nullptr;
+  Page* current = writable_first_;
+  while (current) {
+    count++;
+    if (count > keep_count) {
+      if (prev) {
+        prev->next_ = nullptr;
+        writable_last_ = prev;
+      } else {
+        if (current_page_used_ == 0) {
+          writable_first_ = nullptr;
+          writable_last_ = nullptr;
+        } else {
+          break;
+        }
+      }
+      while (current) {
+        Page* next = current->next_;
+        delete current;
+        current = next;
+      }
+      break;
+    }
+    prev = current;
+    current = current->next_;
+  }
+}
