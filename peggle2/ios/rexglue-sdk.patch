+void AwaitFenceEventBounded(ID3D12Device* device, ID3D12Fence* fence, UINT64 await_value,
+                            HANDLE fence_event, const std::atomic<bool>& running,
+                            GraphicsSystem* graphics_system, const char* op_name,
+                            std::atomic<uint64_t>* fence_timeout_count,
+                            std::atomic<bool>* device_lost_flag,
+                            std::atomic<uint32_t>* device_removed_reason) {
+  if (!fence || !fence_event) {
+    return;
+  }
+  uint32_t wait_seconds = 0;
+  while (fence->GetCompletedValue() < await_value) {
+    const DWORD wait_rc = WaitForSingleObject(fence_event, 1000);
+    if (fence->GetCompletedValue() >= await_value) {
+      return;
+    }
+    if (!running.load(std::memory_order_acquire)) {
+      return;
+    }
+    if (device) {
+      const HRESULT removed = device->GetDeviceRemovedReason();
+      if (FAILED(removed)) {
+        REXGPU_ERROR("D3D12CommandProcessor: device removed (0x{:08X}) while awaiting {}",
+                     static_cast<uint32_t>(removed), op_name);
+        if (device_removed_reason) {
+          device_removed_reason->store(static_cast<uint32_t>(removed), std::memory_order_release);
+        }
+        if (device_lost_flag) {
+          device_lost_flag->store(true, std::memory_order_release);
+        }
+        if (graphics_system) {
+          graphics_system->OnHostGpuLossFromAnyThread(removed != DXGI_ERROR_DEVICE_REMOVED);
+        }
+        return;
+      }
+    }
+    if (wait_rc == WAIT_FAILED) {
+      REXGPU_ERROR("D3D12CommandProcessor: WaitForSingleObject failed while awaiting {}", op_name);
+      if (device_lost_flag) {
+        device_lost_flag->store(true, std::memory_order_release);
+      }
+      return;
+    }
+    if (++wait_seconds == 2 || wait_seconds >= 10) {
+      REXGPU_ERROR(
+          "D3D12CommandProcessor: {} fence wait stalled ({}s, completed={} await={})", op_name,
+          wait_seconds, fence->GetCompletedValue(), await_value);
+      if (wait_seconds >= 10) {
+        if (fence_timeout_count) {
+          fence_timeout_count->fetch_add(1, std::memory_order_relaxed);
+        }
+        return;
+      }
+    }
+  }
+}
