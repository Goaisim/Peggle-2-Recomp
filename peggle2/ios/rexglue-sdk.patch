+REX_GPU_EXPORT void RexGpu_NotifyDpadInput(uint16_t dpad_mask, uint64_t /*timestamp_ms*/) {
+  g_last_dpad_mask.store(dpad_mask, std::memory_order_relaxed);
+  g_dpad_seq.fetch_add(1, std::memory_order_release);
