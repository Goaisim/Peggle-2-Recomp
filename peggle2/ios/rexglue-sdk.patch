+int socket_bind_ipv4(SocketHandle handle, uint16_t sin_family, uint32_t sin_addr_be,
+                     uint16_t sin_port_be, uint16_t* out_bound_port_host, int* out_err) {
+  sockaddr_in nname{};
+#if REX_PLATFORM_MAC
+  // Darwin sockaddr_in puts sin_len (1B) + sin_family (1B) where Win32/guest has 2B sin_family.
+  nname.sin_len = sizeof(sockaddr_in);
+#endif
+  nname.sin_family = static_cast<decltype(nname.sin_family)>(sin_family);
+  nname.sin_addr.s_addr = sin_addr_be;
+  nname.sin_port = sin_port_be;
+  const int fd = static_cast<int>(handle);
+  int ret = ::bind(fd, reinterpret_cast<const sockaddr*>(&nname), sizeof(nname));
+  if (ret < 0 && (errno == EACCES || errno == EPERM || errno == EADDRINUSE) &&
+      nname.sin_port != 0 && ntohs(nname.sin_port) < 1024) {
+    // Non-root Darwin/POSIX sandboxes deny privileged ports (<1024); retry ephemeral port 0.
+    nname.sin_port = 0;
+    ret = ::bind(fd, reinterpret_cast<const sockaddr*>(&nname), sizeof(nname));
+  }
+  if (ret < 0 && (errno == EACCES || errno == EPERM || errno == EADDRNOTAVAIL || errno == EINVAL) &&
+      nname.sin_addr.s_addr == 0) {
+    // Physical iOS sandboxes can deny INADDR_ANY; fall back to loopback ephemeral bind.
+    nname.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    nname.sin_port = 0;
+    ret = ::bind(fd, reinterpret_cast<const sockaddr*>(&nname), sizeof(nname));
+  }
+  if (ret < 0) {
+    if (out_err) *out_err = errno;
+    return -1;
+  }
+  if (out_bound_port_host) {
+    sockaddr_in bound{};
+    socklen_t bound_len = sizeof(bound);
+    *out_bound_port_host =
+        (::getsockname(fd, reinterpret_cast<sockaddr*>(&bound), &bound_len) == 0)
+            ? ntohs(bound.sin_port)
+            : ntohs(nname.sin_port);
+  }
+  return 0;
+}
+
+int socket_getsockname_ipv4(SocketHandle handle, uint16_t* out_family, uint32_t* out_addr_be,
+                            uint16_t* out_port_be, int* out_err) {
+  sockaddr_in nname{};
+  socklen_t nlen = sizeof(nname);
+  if (::getsockname(static_cast<int>(handle), reinterpret_cast<sockaddr*>(&nname), &nlen) < 0) {
+    if (out_err) *out_err = errno;
+    return -1;
+  }
+  if (out_family) *out_family = static_cast<uint16_t>(nname.sin_family);
+  if (out_addr_be) *out_addr_be = nname.sin_addr.s_addr;
+  if (out_port_be) *out_port_be = nname.sin_port;
+  return 0;
+}
+
 }  // namespace rex::net
