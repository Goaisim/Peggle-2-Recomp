+
+void Presenter::SetLastHostGpuMs(float gpu_ms) {
+  if (!std::isfinite(gpu_ms) || gpu_ms < 0.0f) {
+    return;
+  }
+  const float cur = s_last_host_gpu_ms.load(std::memory_order_relaxed);
+  s_last_host_gpu_ms.store(cur <= 0.0f ? gpu_ms : (cur * 0.75f + gpu_ms * 0.25f),
+                           std::memory_order_relaxed);
+}
+
+float Presenter::GetLastHostGpuMs() {
+  return s_last_host_gpu_ms.load(std::memory_order_relaxed);
+}
