+void D3D12CommandProcessor::RollGpuRateWindow() const {
+  const int64_t now_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+  int64_t start_ms = gpu_rate_window_start_ms_.load(std::memory_order_acquire);
+  if (start_ms == 0) {
+    gpu_rate_window_start_ms_.compare_exchange_strong(start_ms, now_ms, std::memory_order_acq_rel);
+    return;
+  }
+  const int64_t elapsed_ms = now_ms - start_ms;
+  if (elapsed_ms >= 1000) {
+    if (gpu_rate_window_start_ms_.compare_exchange_strong(start_ms, now_ms,
+                                                          std::memory_order_acq_rel)) {
+      const uint64_t draws_now = gpu_draw_count_.load(std::memory_order_acquire);
+      const uint64_t resolves_now = gpu_resolve_count_.load(std::memory_order_acquire);
+      const uint64_t prev_draws =
+          gpu_rate_prev_draws_.exchange(draws_now, std::memory_order_acq_rel);
+      const uint64_t prev_resolves =
+          gpu_rate_prev_resolves_.exchange(resolves_now, std::memory_order_acq_rel);
+      const uint64_t dd = (draws_now >= prev_draws) ? (draws_now - prev_draws) : 0;
+      const uint64_t dr = (resolves_now >= prev_resolves) ? (resolves_now - prev_resolves) : 0;
+      gpu_draws_per_sec_.store(
+          uint32_t((dd * 1000ull + uint64_t(elapsed_ms / 2)) / uint64_t(elapsed_ms)),
+          std::memory_order_release);
+      gpu_resolves_per_sec_.store(
+          uint32_t((dr * 1000ull + uint64_t(elapsed_ms / 2)) / uint64_t(elapsed_ms)),
+          std::memory_order_release);
+    }
+  }
+}
+
+void D3D12CommandProcessor::RecordGpuDrawSubmitted() {
+  gpu_draw_count_.fetch_add(1, std::memory_order_relaxed);
+  RollGpuRateWindow();
+}
+
+void D3D12CommandProcessor::RecordGpuResolveExecuted() {
+  gpu_resolve_count_.fetch_add(1, std::memory_order_relaxed);
+  RollGpuRateWindow();
 }
 
