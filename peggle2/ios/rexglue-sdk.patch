+
+void Presenter::RecordGuestFrameBreakdown(float active_work_ms, float kernel_wait_ms,
+                                          float gpu_pm4_ms, float physics_debt_ms, bool skipped,
+                                          float dt_scale, uint32_t draw_calls_per_frame,
+                                          uint32_t vertex_uploads_per_frame) {
+  auto smooth = [](std::atomic<float>& slot, float sample, bool init) {
+    float cur = slot.load(std::memory_order_relaxed);
+    slot.store(init ? sample : (cur * 0.5f + sample * 0.5f), std::memory_order_relaxed);
+  };
+  const auto now = std::chrono::steady_clock::now();
+  const bool init = !s_breakdown_initialized;
+  smooth(s_breakdown_active_work_ms, active_work_ms, init);
+  smooth(s_breakdown_kernel_wait_ms, kernel_wait_ms, init);
+  smooth(s_breakdown_gpu_pm4_ms, gpu_pm4_ms, init);
+  s_breakdown_physics_debt_ms.store(physics_debt_ms, std::memory_order_relaxed);
+  s_breakdown_dt_scale.store(dt_scale, std::memory_order_relaxed);
+  s_breakdown_draw_calls.store(draw_calls_per_frame, std::memory_order_relaxed);
+  s_breakdown_vertex_uploads.store(vertex_uploads_per_frame, std::memory_order_relaxed);
+
+  if (init) {
+    s_breakdown_initialized = true;
+    s_breakdown_window_start = now;
+    s_breakdown_window_skips = skipped ? 1 : 0;
+    return;
+  }
+  if (skipped) {
+    ++s_breakdown_window_skips;
+  }
+  const float elapsed_s =
+      std::chrono::duration<float>(now - s_breakdown_window_start).count();
+  if (elapsed_s >= 1.0f) {
+    const uint32_t rate = static_cast<uint32_t>(
+        std::lround(static_cast<double>(s_breakdown_window_skips) / elapsed_s));
+    s_breakdown_skips_per_sec.store(rate, std::memory_order_relaxed);
+    s_breakdown_window_skips = 0;
+    s_breakdown_window_start = now;
+  }
+}
+
+GuestFrameBreakdown Presenter::GetGuestFrameBreakdown() {
+  GuestFrameBreakdown out;
+  out.active_work_ms = s_breakdown_active_work_ms.load(std::memory_order_relaxed);
+  out.kernel_wait_ms = s_breakdown_kernel_wait_ms.load(std::memory_order_relaxed);
+  out.gpu_pm4_ms = s_breakdown_gpu_pm4_ms.load(std::memory_order_relaxed);
+  out.gpu_hw_ms = s_last_host_gpu_ms.load(std::memory_order_relaxed);
+  out.physics_debt_ms = s_breakdown_physics_debt_ms.load(std::memory_order_relaxed);
+  out.skips_per_sec = s_breakdown_skips_per_sec.load(std::memory_order_relaxed);
+  out.dt_scale = s_breakdown_dt_scale.load(std::memory_order_relaxed);
+  out.draw_calls_per_frame = s_breakdown_draw_calls.load(std::memory_order_relaxed);
+  out.vertex_uploads_per_frame = s_breakdown_vertex_uploads.load(std::memory_order_relaxed);
+  return out;
+}
