+void CopyBoundedCString(char* dst, size_t dst_size, const char* src) {
+  if (!dst || dst_size == 0) return;
+  size_t i = 0;
+  if (src) {
+    for (; i + 1 < dst_size && src[i] != '\0'; ++i) {
+      dst[i] = src[i];
+    }
+  }
+  dst[i] = '\0';
+}
