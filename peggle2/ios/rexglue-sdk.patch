+void Presenter::SetResolutionScale(float scale) {
+  const float prev = s_resolution_scale.exchange(scale, std::memory_order_relaxed);
+  if (std::abs(scale - prev) <= 0.001f) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(s_presenter_mutex);
+  if (s_active_presenter) {
+    s_active_presenter->SetGuestOutputPaintConfigFromUIThread(
+        BuildGuestOutputPaintConfigFromCVar());
+    s_active_presenter->RequestPaintOrConnectionRecoveryViaWindow(true);
+  }
