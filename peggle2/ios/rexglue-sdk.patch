+
+void Presenter::ApplyFramePacing() {
+  int32_t target_fps = GetEffectiveTargetFps();
+
+  if (!guest_is_active()) {
+    // Smooth 60 FPS pacing while waiting for guest boot / launcher UI
+    if (target_fps <= 0) {
+      target_fps = 60;
+    }
+  } else if (target_fps <= 60 && target_fps != 40) {
+    // When guest is active and target_fps <= 60 (except 40 Hz 3:2 host pacer),
+    // guest 60 Hz pacer and s_new_guest_frame_ready already govern cadence.
+    has_frame_pacing_target_ = false;
+    return;
+  }
+
+  const auto frame_interval =
+      std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+          std::chrono::duration<double>(1.0 / static_cast<double>(target_fps)));
+
+  const auto now = std::chrono::steady_clock::now();
+  if (!has_frame_pacing_target_) {
+    frame_pacing_next_frame_time_ = now + frame_interval;
+    has_frame_pacing_target_ = true;
+    return;
+  }
+
+  if (now < frame_pacing_next_frame_time_) {
+#if defined(__APPLE__) || (!defined(_MSC_VER) && !defined(__x86_64__) && !defined(_M_X64))
+    // Use true OS blocking sleep on Apple/ARM64 so UI pacing cores never busy-spin.
+    std::this_thread::sleep_until(frame_pacing_next_frame_time_);
+#else
+    const auto remaining = frame_pacing_next_frame_time_ - now;
+    // Sleep until 1.5ms before deadline to conserve APU wattage
+    if (remaining > std::chrono::microseconds(1500)) {
+      std::this_thread::sleep_for(remaining - std::chrono::microseconds(1500));
+    }
+    // Spin-wait with _mm_pause for the final interval for jitter-free pacing
+    while (std::chrono::steady_clock::now() < frame_pacing_next_frame_time_) {
+      _mm_pause();
+    }
+#endif
+  }
+
+  frame_pacing_next_frame_time_ += frame_interval;
+  const auto post_wait_now = std::chrono::steady_clock::now();
+  if (post_wait_now > frame_pacing_next_frame_time_ + frame_interval) {
+    frame_pacing_next_frame_time_ = post_wait_now + frame_interval;
+  }
+}
