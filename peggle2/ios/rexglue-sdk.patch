+
+uint64_t NowSteadyMs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+class PositionExportSink : public rex::graphics::ShaderInterpreter::ExportSink {
+ public:
+  void Reset() {
+    has_pos = false;
+    pos[0] = pos[1] = pos[2] = 0.0f;
+    pos[3] = 1.0f;
+  }
+
+  void Export(rex::graphics::ucode::ExportRegister export_register, const float* value,
+              uint32_t value_mask) override {
+    if (export_register == rex::graphics::ucode::ExportRegister::kVSPosition) {
+      has_pos = true;
+      for (uint32_t i = 0; i < 4; ++i) {
+        if (value_mask & (UINT32_C(1) << i)) {
+          pos[i] = value[i];
+        }
+      }
+    }
+  }
+
+  bool has_pos = false;
+  float pos[4]{};
+};
+
+float RectIoU(float ax0, float ay0, float ax1, float ay1, float bx0, float by0, float bx1, float by1,
+              float* out_containment = nullptr) {
+  float ix0 = std::max(ax0, bx0);
+  float iy0 = std::max(ay0, by0);
+  float ix1 = std::min(ax1, bx1);
+  float iy1 = std::min(ay1, by1);
+  if (ix1 <= ix0 || iy1 <= iy0) {
+    if (out_containment) *out_containment = 0.0f;
+    return 0.0f;
+  }
+  float inter = (ix1 - ix0) * (iy1 - iy0);
+  float area_a = std::max(1e-7f, (ax1 - ax0) * (ay1 - ay0));
+  float area_b = std::max(1e-7f, (bx1 - bx0) * (by1 - by0));
+  if (out_containment) {
+    *out_containment = inter / std::min(area_a, area_b);
+  }
+  return inter / std::max(1e-7f, area_a + area_b - inter);
+}
+
+uint32_t HashPixelConstants(const rex::graphics::RegisterFile& regs) {
+  // Hash first 8 pixel shader float constant vectors (c0..c7 -> regs 256..263 * 4) for tint/glow diffing.
+  uint32_t h = 2166136261u;
+  uint32_t base_reg = rex::graphics::XE_GPU_REG_SHADER_CONSTANT_000_X + 256 * 4;
+  for (uint32_t i = 0; i < 32; ++i) {
+    uint32_t v = regs[base_reg + i];
+    h ^= v;
+    h *= 16777619u;
+  }
+  return h;
+}
