+void RecomputeBootStage(uint32_t mask) {
+  int stage = 0;
+  if (mask & (1u << 1)) stage = 1;
+  if (stage >= 1 && (mask & (1u << 2))) stage = 2;
+  if (stage >= 2 && (mask & (1u << 3))) stage = 3;
+  if (stage >= 2 && (mask & (1u << 4))) stage = 4;
+  if (stage >= 2 && (mask & (1u << 5))) stage = 5;
+  int prev = g_ios_boot_stage.load(std::memory_order_relaxed);
+  while (stage > prev &&
+         !g_ios_boot_stage.compare_exchange_weak(prev, stage, std::memory_order_relaxed)) {
+  }
+}
